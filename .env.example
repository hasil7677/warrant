# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#
# .env is gitignored. Nothing in this project writes it, and nothing commits it.
# The model never reads any of these - only warrant/auth.py does, and only the
# broker calls auth.

# Notion — notion.so/my-integrations -> New integration -> Internal
# -> Configuration tab -> Internal Integration Secret
NOTION_API_KEY=ntn_replace_me

# The Notion page the agent may write to. Open the page, copy the 32-hex blob
# from its URL. Share the page with your integration first:
#   page -> ... -> Connections -> Connect to -> your integration
# Put this SAME id in policy.yaml under notion_parent_allowlist.allowed_parents.
WARRANT_SMOKE_PARENT=00000000000000000000000000000000

# The model. Bedrock Converse, Mistral by default - swapping model families is
# an env var, not a code change, because the gate does not care who proposes.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
BEDROCK_MODEL_ID=mistral.mistral-large-3-675b-instruct   # Mistral's flagship
# WARRANT_MODEL=anthropic.claude-opus-5                 # same loop, other family

# Google needs no key here: OAuth uses client_secret.json + token.json.
